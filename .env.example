# BugProof Cloud (apps/web) + bugproof-mcp
BUGPROOF_API_URL=
BUGPROOF_INGEST_TOKEN=

# Upstash Redis (cases, events, evidence) — apps/web/src/lib/store falls back
# to an in-memory store when none of these are set (local dev is fine without
# them; the mock/hero case still works via apps/web/data/cases/*.json).
# Set ONE of these pairs:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# ...or, if you added Redis via the Vercel Marketplace Upstash integration,
# it sets these automatically (no action needed beyond connecting the project):
KV_REST_API_URL=
KV_REST_API_TOKEN=

# IBM watsonx.ai (Granite triage + proof summaries)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=

# GitHub (get_issue, PRs)
GITHUB_TOKEN=
