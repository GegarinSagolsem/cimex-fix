{
  "name": "bugproof-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for the BugProof Bob pack (open_case, record, run_tests, bisect, publish_proof).",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "bugproof-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "node --max-old-space-size=4096 ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bugproof/shared": "*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "typescript": "^5"
  }
}
